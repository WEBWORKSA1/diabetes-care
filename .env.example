# ============================================
# diabetes.care — Environment Variables
# ============================================
# Copy this to .env.local and fill in real values
# Never commit .env.local to git
# All keys marked PROD must use HIPAA-BAA accounts

# ====== SUPABASE (PHI database) ======
# Get from supabase.com dashboard → Settings → API
# CRITICAL: Use Team plan ($599/mo) with signed BAA — Free/Pro tier is NOT HIPAA compliant
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here
SUPABASE_PROJECT_ID=your-project-id

# ====== ANTHROPIC (AI clinical note generation) ======
# Get from console.anthropic.com → Settings → API Keys
# Request BAA: privacy@anthropic.com for HIPAA workloads
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# ====== OPENAI (Whisper transcription only) ======
# Get from platform.openai.com → API keys
# Request BAA via Enterprise sales for HIPAA workloads
OPENAI_API_KEY=sk-proj-xxx

# ====== STRIPE (subscription billing) ======
# Get from dashboard.stripe.com → Developers → API keys
# Stripe signs BAAs for healthcare customers — contact Stripe sales
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ====== POSTMARK (transactional email) ======
# postmarkapp.com — signs BAA on request
POSTMARK_API_KEY=xxx
POSTMARK_FROM_EMAIL=hello@diabetes.care

# ====== TWILIO (SMS appointment reminders) ======
# twilio.com — signs BAA for SMS workloads
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+15555555555

# ====== DEXCOM (CGM data — v1) ======
# developer.dexcom.com — OAuth2 client credentials
# Sandbox first, production after partner agreement
DEXCOM_CLIENT_ID=xxx
DEXCOM_CLIENT_SECRET=xxx
DEXCOM_REDIRECT_URI=https://app.diabetes.care/api/cgm/dexcom/callback
DEXCOM_API_BASE=https://sandbox-api.dexcom.com

# ====== POSTHOG (product analytics — no PHI) ======
# posthog.com — signs BAA on Cloud plan
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ====== APPLICATION ======
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=diabetes.care
NODE_ENV=development
